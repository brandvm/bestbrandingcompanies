{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bestbrandingcompanies",
  "account_id": "ce645e22953cc9c203c64fe0f2bada66",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/images/*",
      "!/_analytics/*",
      "!/brand/*"
    ]
  },
  "routes": [
    {
      "pattern": "www.bestbrandingcompanies.com",
      "custom_domain": true,
      "zone_id": "28778edb7f568ee7c01d72acc28fa4ec",
      "previews_enabled": false
    },
    {
      "pattern": "bestbrandingcompanies.com",
      "custom_domain": true,
      "zone_id": "28778edb7f568ee7c01d72acc28fa4ec",
      "previews_enabled": false
    }
  ],
  "main": "server/production.mjs"
}
