---
import Page from '../layouts/Page.astro';import Feature from '../components/Feature.astro';import GuideCard from '../components/GuideCard.astro';import Cover from '../components/Cover.astro';import Icon from '../components/Icon.astro';import AgencyIndex from '../components/AgencyIndex.astro';import Approach from '../components/Approach.astro';
import site from '../data/site.json';import {articles,href,withBase} from '../lib/content';
const posts=await articles();const featured=posts[0];
---
<Page>
<section class="hero" data-review-anchor="hero"><p class="eyebrow">A journal of brand & business</p><h1>Good brands begin<br>with <em>great partners.</em></h1><p class="intro">A closer look at the companies shaping how brands look, sound, and connect. Find the right creative partner for what comes next.</p><div class="actions"><a class="button" href={withBase("/blog/")}>Explore the guides <Icon name="arrow-up-right"/></a><a class="text-link" href="#our-approach">Our approach</a></div></section><div class="brand-ribbon" aria-hidden="true"><div class="ribbon-copy"><b>10</b><p>Companies.<br>Distinct perspectives.</p></div><Cover eager/><p class="ribbon-note">A thoughtful identity.<br>A lasting impression.</p></div><section class="section" data-review-anchor="guides"><Feature post={featured}/></section><section class="section" data-review-anchor="agency-shortlist"><div class="index-head"><div><p class="eyebrow">Inside the guide</p><h2>Start your shortlist.</h2></div></div>{featured&&<AgencyIndex slug={featured.data.slug}/>}<p class="small" style="margin-top:20px">The first three agencies in the guide. Read the full comparison for rankings, qualifications, and methodology.</p></section><Approach/></Page>
